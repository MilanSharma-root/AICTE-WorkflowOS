# Default local development uses SQLite. For multiple laptops/instances, point each deployment to the same hosted PostgreSQL DATABASE_URL and shared durable document storage.
DATABASE_URL=sqlite:///./aicte_workflowos.db
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
# Replace with a long random value before deployment.
SECRET_KEY=replace-with-a-long-random-secret

# Optional correction email delivery. Leave blank to use in-app alerts only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
